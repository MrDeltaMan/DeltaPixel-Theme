[Desktop Entry]
Version=1.1
Type=Application
Name=Fontes
Comment=Veja fontes no seu sistema
Icon=cs-fonts
DBusActivatable=true
Exec=gnome-font-viewer %u
Actions=
MimeType=application/x-font-ttf;application/x-font-pcf;application/x-font-type1;application/x-font-otf;font/ttf;font/otf;font/woff;
Categories=GNOME;GTK;Utility;X-GNOME-Utilities;
Keywords=fontes;tipo de fonte;tipo da fonte;
StartupNotify=true
